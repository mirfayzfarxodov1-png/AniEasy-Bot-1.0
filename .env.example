# Telegram
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
ADMIN_IDS=PUT_ADMIN_ID_HERE
OWNER_ID=PUT_OWNER_ID_HERE

# Database
# Local development:
DATABASE_URL=sqlite+aiosqlite:///./anime_bot.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://animebot:CHANGE_ME@postgres:5432/animebot

# Optional Telegram channels
CHANNEL_ID=
LOG_CHANNEL_ID=

# Optional Telegram Web App (must be HTTPS)
WEBAPP_URL=

# App settings
PAGINATION_SIZE=10
DESCRIPTION_TEMPLATE=🎬 {anime_name}\n📺 {episode}-qism
LOG_LEVEL=INFO
