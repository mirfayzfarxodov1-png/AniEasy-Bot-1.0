# Telegram
BOT_TOKEN=PUT_NEW_BOT_TOKEN_HERE
ADMIN_IDS=PUT_ADMIN_ID_HERE
OWNER_ID=PUT_OWNER_ID_HERE

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/anime_bot.db
# Production / persistent hosting: put the async PostgreSQL URL in DATABASE_URL.
# Example:
# DATABASE_URL=postgresql+asyncpg://animebot:CHANGE_ME@host:5432/animebot

# Optional Telegram channels
CHANNEL_ID=
LOG_CHANNEL_ID=
# Mandatory public channels, comma separated. Example: @mychannel,@anotherchannel
MANDATORY_CHANNELS=

# WebApp intentionally disabled in the bot menu
WEBAPP_URL=

# App settings
PAGINATION_SIZE=10
DESCRIPTION_TEMPLATE=🎬 {anime_name}\n📺 {episode}-qism
LOG_LEVEL=INFO
